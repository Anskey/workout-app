rules_version = '2';

// Each signed-in user can only read/write their own single sync document at
// users/{their uid}. Paste this into Firebase Console -> Firestore Database -> Rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
