# Copy this file to .env.local and fill in the values from your Firebase project's
# Web app config (Firebase Console -> Project settings -> Your apps -> Web app -> SDK setup).
# These are client-side config identifiers, not secrets — they're safe to embed in an
# app bundle; the account/data protection comes from Firestore security rules instead.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
